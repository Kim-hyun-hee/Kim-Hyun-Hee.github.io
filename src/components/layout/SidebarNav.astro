---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  CATEGORIES,
  CATEGORY_IDS,
  getSubcategoryIds,
  getSubcategoryLabel,
  hasSubcategories,
} from "@/categories";
import type { CategoryCounts } from "@/utils/getCategoryCounts";
import { getPathSegments } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = { counts: CategoryCounts };
const { counts } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const segments = getPathSegments(Astro.url.pathname, locale);
const activeCategory = segments[0] === "categories" ? segments[1] : undefined;
const activeSubcategory =
  segments[0] === "categories" ? segments[2] : undefined;

const postsHref = getRelativeLocaleUrl(locale, "posts");
const postsActive = segments[0] === "posts";
---

<nav aria-label={t.nav.categories}>
  <a
    href={postsHref}
    class="cat-title"
    aria-current={postsActive ? "page" : undefined}
  >
    <span>{t.nav.allByCategory}</span>
    <span class="cnt">{counts.total}</span>
  </a>
  <ul>
    {
      CATEGORY_IDS.map(id => {
        const category = CATEGORIES[id];
        const href = getRelativeLocaleUrl(locale, `categories/${id}`);
        const open = activeCategory === id;
        // 잎(현재 페이지)만 강조: 소분류를 보는 중이면 대분류는 강조하지 않는다.
        const catActive = activeCategory === id && !activeSubcategory;

        if (!hasSubcategories(id)) {
          return (
            <li>
              <a
                href={href}
                class:list={["cat-row", { "is-active": catActive }]}
                aria-current={catActive ? "page" : undefined}
              >
                <span class="label">{category.label}</span>
                <span class="cnt">{counts.byCategory[id]}</span>
              </a>
            </li>
          );
        }

        return (
          <li class:list={{ open }}>
            <a
              href={href}
              class:list={["cat-row", { "is-active": catActive }]}
              aria-current={catActive ? "page" : undefined}
            >
              <span class="label">{category.label}</span>
              <span class="cnt">{counts.byCategory[id]}</span>
            </a>
            <button
              type="button"
              class="cat-chev"
              aria-label={t.a11y.toggleSubcategories}
              aria-expanded={open ? "true" : "false"}
              aria-controls={`subs-${id}`}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
            <div class="sub-wrap" id={`subs-${id}`}>
              <div class="sub-inner">
                <ul class="subs">
                  {getSubcategoryIds(id).map(sub => {
                    const subActive =
                      activeCategory === id && activeSubcategory === sub;
                    return (
                      <li>
                        <a
                          href={getRelativeLocaleUrl(
                            locale,
                            `categories/${id}/${sub}`
                          )}
                          class:list={["sub-link", { "is-active": subActive }]}
                          aria-current={subActive ? "page" : undefined}
                        >
                          <span class="label">{getSubcategoryLabel(id, sub)}</span>
                          <span class="cnt">{counts.bySubcategory[`${id}/${sub}`]}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* 분류 전체보기: 대분류 위의 굵은 제목 + 총계 배지 */
  .cat-title {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
  }
  .cat-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  nav > ul {
    display: flex;
    flex-direction: column;
    row-gap: 0.875rem;
    font-size: 0.875rem;
  }
  nav li {
    position: relative;
  }

  /* 대분류: 살짝 굵게(medium), 연한 회색. hover/현재 위치에서 진해진다. */
  .cat-row {
    display: flex;
    align-items: center;
    width: 100%;
    padding-right: 1.25rem;
    font-weight: 500;
    color: var(--sidebar-link);
    text-decoration: none;
  }
  .cat-row:hover,
  .cat-row.is-active {
    color: var(--foreground);
  }

  /* 카운트 배지 */
  .cnt {
    margin-left: 0.3rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sidebar-link) 12%, transparent);
    padding: 0.15rem 0.4rem;
    font-size: 0.625rem;
    line-height: 1;
    color: var(--sidebar-link);
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }

  /* 아코디언 토글: 이름과 분리된 우측 아이콘. 클릭 시 회전. */
  .cat-chev {
    position: absolute;
    right: -0.25rem;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--sidebar-link);
    transition: transform 180ms ease;
  }
  .cat-chev:hover {
    color: var(--foreground);
  }
  li.open > .cat-chev {
    transform: rotate(90deg);
  }
  .cat-chev svg {
    width: 0.625rem;
    height: 0.625rem;
  }

  /* 소분류 목록: 접힘/펼침 애니메이션 */
  .sub-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease;
  }
  li.open > .sub-wrap {
    grid-template-rows: 1fr;
  }
  .sub-inner {
    overflow: hidden;
  }

  /* 왼쪽 가이드 레일(들여쓰기 + 세로 인셋)로 하위 묶음을 구분 */
  .subs {
    position: relative;
    display: flex;
    flex-direction: column;
    row-gap: 0.8125rem;
    padding: 1rem 0 0.25rem 1.75rem;
  }
  .subs::before {
    content: "";
    position: absolute;
    left: 0.8125rem;
    top: 1.125rem;
    bottom: 0.5rem;
    width: 1.5px;
    border-radius: 2px;
    background: var(--border);
  }
  .sub-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--sidebar-link);
    text-decoration: none;
  }
  .sub-link:hover,
  .sub-link.is-active {
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-chev,
    .sub-wrap {
      transition: none;
    }
  }
</style>

<script>
  // 우측 아이콘만 아코디언을 토글한다. 이름 클릭은 분류 페이지로 이동.
  // document 위임이라 뷰 트랜지션 이후에도 유지되도록 한 번만 바인딩한다.
  function toggleSubcategory(e: Event) {
    const chev = (e.target as HTMLElement).closest<HTMLElement>(".cat-chev");
    if (!chev) return;
    const li = chev.closest<HTMLElement>("li");
    if (!li) return;
    const open = li.classList.toggle("open");
    chev.setAttribute("aria-expanded", String(open));
  }

  const w = window as unknown as { __sidebarNavBound?: boolean };
  if (!w.__sidebarNavBound) {
    w.__sidebarNavBound = true;
    document.addEventListener("click", toggleSubcategory);
  }
</script>
