---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  icon?: boolean;
  pubDatetime: string | Date;
  timezone?: string;
};

const {
  pubDatetime,
  size = "sm",
  icon = true,
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

// 수정 여부와 관계없이 쓴 날짜를 보여준다. 목록·아카이브의 정렬 기준과 같다.
const datetime = dayjs(pubDatetime).tz(postTimezone ?? config.site.timezone);

const date = datetime.format("YYYY[년] M[월] D[일]");
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  {
    icon && (
      <IconCalendar
        class:list={[
          "inline-block size-6 min-w-5.5",
          { "scale-90": size === "sm" },
        ]}
      />
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
